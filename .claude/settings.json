{
  "permissions": {
    "allow": [
      "Bash(gh pr merge:*)"
    ],
    "deny": [
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(//home/*/.aws/**)",
      "Read(//home/*/.config/gh/**)",
      "Bash(cat ~/.aws/*)",
      "Bash(cat ~/.config/gh/*)",
      "Bash(gh auth token:*)",
      "Bash(aws configure get:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/subagent-guardrails.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/subagent-mcp-guardrails.sh"
          }
        ]
      }
    ]
  }
}
