{
  "permissions": {
    "allow": [
      "Bash(gh pr merge:*)",
      "Bash(/home/nghiep/projects/AA-Ecosys/tools/github/as-app.sh:*)",
      "Bash(gh workflow run:*)",
      "Bash(vercel env add:*)",
      "Bash(vercel env rm:*)"
    ],
    "deny": [
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(//home/*/.aws/**)",
      "Read(//home/*/.config/gh/**)",
      "Bash(cat ~/.aws/*)",
      "Bash(cat ~/.config/gh/*)",
      "Bash(gh auth token:*)",
      "Bash(aws configure get:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/subagent-guardrails.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/subagent-mcp-guardrails.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/kit-core-edit-guard.sh"
          }
        ]
      }
    ]
  }
}
