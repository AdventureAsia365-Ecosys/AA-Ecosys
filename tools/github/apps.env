# Non-secret identifiers for the org's GitHub Apps (ADR 0011, AA-901). Read by tools/github/as-app.sh.
# Keys are never stored here: the aa-agent key lives in Secrets Manager (name below); the aa-ci-bot key is a
# GitHub secret in each consuming repo. Created S247, 22/10/2026 (docs/security/github-apps.md).
github_org=AdventureAsia365-Ecosys
agent_app_id=5421824
# aa-ci-bot was created as aa-ecosys-ci-bot (the short name was taken); its key is the GitHub secret
# AA_CI_BOT_PRIVATE_KEY (environment release in the public app repos, repo level in AA-CIS-Infra).
ci_bot_app_slug=aa-ecosys-ci-bot
ci_bot_app_id=5421877
agent_key_secret=aa-ecosys/github/aa-agent-app-key
key_profile=aa365-admin
key_region=us-west-1
