# Non-secret identifiers for the org's GitHub Apps (ADR 0011, AA-901). Read by tools/github/as-app.sh.
# Keys are never stored here: the aa-agent key lives in Secrets Manager (name below); the aa-ci-bot key is a
# GitHub secret in each consuming repo. Fill agent_app_id after the App is created (docs/security/github-apps.md).
github_org=AdventureAsia365-Ecosys
agent_app_id=
agent_key_secret=aa-ecosys/github/aa-agent-app-key
key_profile=aa365-admin
key_region=us-west-1
