// Markdown style for docs (AA-887 settings, AA-888 lint). Used by the docs-lint workflow (failing step) and by
// editors with the markdownlint extension. Local run: npx markdownlint-cli2@0.23.2 'docs/**/*.md' (the version the
// pinned action uses).
{
  "config": {
    "default": true,
    "MD013": false, // line length: prose wraps at ~120 by convention, tables do not
    "MD033": false, // inline HTML: GitHub alerts, <details>, comments
    "MD041": false, // first line: front-matter comes first
    "MD024": { "siblings_only": true },
    "MD025": { "front_matter_title": "" }, // front-matter title and the H1 are both kept on purpose (STYLE.md)
    "MD060": false // table pipes: the house style is `| a | b |` over `|---|---|`, which no MD060 style accepts
  },
  // Journals and archived pages keep their history as written; generated pages change only through their
  // generator (docs/generated: AA-CIS-Infra docs-gen.yml; docs/linear-export: the Linear export tool).
  "ignores": [
    "docs/sessions/**",
    "docs/audits/**",
    "docs/implementation-notes/**",
    "docs/backlog/**",
    "docs/research/**",
    "docs/calib/**",
    "docs/backups/**",
    "docs/archive/**",
    "docs/generated/**",
    "docs/linear-export/**",
    "docs/architecture/db-schema-reference.md"
  ]
}
